<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Clipton.Core\Clipton.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.0.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AssemblyName>Clipton</AssemblyName>
    <Version>0.1.25</Version>
    <AssemblyVersion>0.1.25.0</AssemblyVersion>
    <FileVersion>0.1.25.0</FileVersion>
    <InformationalVersion>0.1.25.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWinUI>true</UseWinUI>
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Clipton.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en;ja;de;es;fr;ko;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Opt-in portable build (-p:CliptonPortable=true): bundles the .NET runtime and the Windows App SDK
       so the executable runs without any shared runtime. Store/MSIX and development builds are unchanged. -->
  <PropertyGroup Condition="'$(CliptonPortable)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <DefineConstants>$(DefineConstants);CLIPTON_PORTABLE</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\portable\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable\</IntermediateOutputPath>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CliptonAutomationWindows)' == 'true'">
    <DefineConstants>$(DefineConstants);CLIPTON_AUTOMATION_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Clipton.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CliptonDark.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Clipton.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CliptonDark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CliptonTray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CliptonTrayDark.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\TERMS.en.md" WithCulture="false" LogicalName="Legal.TERMS.en.md" />
    <EmbeddedResource Include="..\..\docs\TERMS.ja.md" WithCulture="false" LogicalName="Legal.TERMS.ja.md" />
    <EmbeddedResource Include="..\..\docs\PRIVACY_POLICY.en.md" WithCulture="false" LogicalName="Legal.PRIVACY_POLICY.en.md" />
    <EmbeddedResource Include="..\..\docs\PRIVACY_POLICY.ja.md" WithCulture="false" LogicalName="Legal.PRIVACY_POLICY.ja.md" />
    <EmbeddedResource Include="..\..\docs\THIRD_PARTY_NOTICES.en.md" WithCulture="false" LogicalName="Legal.THIRD_PARTY_NOTICES.en.md" />
    <Content Include="..\..\docs\THIRD_PARTY_NOTICES.en.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish does not carry the app's PRI index into the output folder; without it the XAML runtime fails at startup. -->
  <Target Name="CliptonPortablePublishPri" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(CliptonPortable)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)Clipton.pri" RelativePath="Clipton.pri" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
